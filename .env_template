# Sandıkv2 uygulamasının ortam değişkenleri.
# Bu dosyayı `.env` (hata ayıklama için `.env_debug`) olarak kopyalayıp değerleri doldurunuz.
# `.env` ve `.env_debug` depoya işlenmez.
# Değerleri tek tırnak içinde yazınız: DEGISKEN='deger'

# Flask oturum çerezlerinin imzalandığı anahtar (zorunlu, gizli tutulmalıdır).
# Parola sıfırlama bağlantılarındaki JWT de bu anahtarla imzalanır.
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
SANDIKv2_SECRET_KEY=''

# Site yöneticisinin e-posta adresi. Bu adresle kayıtlı kullanıcı `WebUser.is_admin()` sayılır;
# hesabı onaylanmamış olsa bile aktif kabul edilir ve yönetim sayfalarını görür.
SANDIKv2_ADMIN_EMAIL_ADDRESS=''

# --- Veritabanı ---
# Sağlayıcı postgres/mysql değilse sqlite kullanılır (sandik/utils/database.sqlite).
SANDIKv2_DATABASE_PROVIDER='<postgres|mysql|sqlite>'
SANDIKv2_DATABASE_URL='<only_for_postgres>'
SANDIKv2_DATABASE_HOST='<only_for_mysql>'
SANDIKv2_DATABASE_USER='<only_for_mysql>'
SANDIKv2_DATABASE_PASSWORD='<only_for_mysql>'
SANDIKv2_DATABASE_DB='<only_for_mysql>'

# Sitenin dışarıdan görünen adresi. Yalnızca `clock.py` kullanır: gecelik iş bir HTTP isteğinin
# içinde çalışmadığı için, e-postalara konulacak mutlak bağlantıları (`url_for(_external=True)`)
# üretebilmek adına kendi Flask örneğine `SERVER_NAME` olarak verilir. Web sürecine verilmez.
# Tanımlı değilse 'sandikv2.myilmaz.tr' varsayılır.
SANDIKv2_SERVER_NAME='sandikv2.myilmaz.tr'

# Şema taşımaları uygulama her açıldığında kendiliğinden çalışır. '0' yapılırsa çalışmaz ve
# taşımalar elle uygulanır: python scripts/migrate.py
# SANDIKv2_AUTO_MIGRATE='1'

# --- E-posta ---
# Parola sıfırlama ve aylık ödeme hatırlatma e-postaları için kullanılır. Tanımlı değilse bu
# özellikler çalışmaz; uygulamanın geri kalanı e-postasız çalışır.
# Gmail için hesabın kendi parolası değil, "uygulama parolası" üretilmelidir.
SANDIKv2_EMAIL_BOT_EMAIL_ADDRESS=''
SANDIKv2_EMAIL_BOT_PASSWORD=''
SANDIKv2_EMAIL_BOT_DISPLAY_NAME='Sandık'
# SMTP sunucusu adresten tahmin edilir (gmail/outlook/itu); farklıysa elle yazınız:
# SANDIKv2_EMAIL_BOT_SMTP_SERVER='smtp.ornek.com:587'

# --- Ödeme hatırlatma e-postaları ---
# `clock.py` her gece çalışır ve o gün mail isteyen kullanıcılara gönderir. Gün, kullanıcının
# kendi tercihidir (varsayılan: ayın 1'inde "bu ayın ödemeleri", 25'inde "bu ay + gelecek ay");
# kullanıcı /tercihlerim sayfasından günü değiştirebilir ya da tamamen kapatabilir.
# Acil kapatma valfi: '0' yapılırsa hiç e-posta gönderilmez. Varsayılan '1' (açık).
# SANDIKv2_REMINDER_EMAIL_ENABLED='1'
# Tanımlıysa bütün hatırlatmalar üyelere değil bu adrese gider ve konuya '[TEST]' eklenir.
# Canlıya almadan önce denemek için kullanılır; boş bırakılırsa gerçek üyelere gönderilir.
# SANDIKv2_REMINDER_EMAIL_TEST_ADDRESS=''
# İki e-posta arasında beklenecek süre (saniye). SMTP sunucusunun hız sınırına takılmamak için.
# Varsayılan: 2
# SANDIKv2_REMINDER_EMAIL_SLEEP_SECONDS='2'

# --- SMS (isteğe bağlı) ---
# Yalnızca 'NETGSM' desteklenir; başka bir değer verilirse SMS gönderimi hata fırlatır.
# Tanımlı değilse SMS özellikleri kullanılmaz.
# SANDIKv2_SMS_BOT_PROVIDER='NETGSM'
# SANDIKv2_SMS_BOT_USERCODE=''
# SANDIKv2_SMS_BOT_PASSWORD=''
# SANDIKv2_SMS_BOT_DEFAULT_MESSAGE_HEADER=''
